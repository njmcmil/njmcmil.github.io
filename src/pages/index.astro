---
import { getCollection } from "astro:content"; // your posts
import { getRelativeLocaleUrl } from "astro:i18n"; // site path

import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

import Layout from "@/layouts/Layout.astro"; // outer-page structure
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
// shared top and bottom portions of the page.
import Socials from "@/components/Socials.astro"; // configured social links
import Card from "@/components/Card.astro";
// displays one post entry, including its linked title, date, and description
import LinkButton from "@/components/LinkButton.astro";
// reusable styled button
import { getSortedPosts } from "@/utils/getSortedPosts";
// project rules for which posts can appear and in what order
import { useTranslations } from "@/i18n";
// looks up interface labels in the selected language
import config from "@/config";
// provides settings such as links, default lang, post limit

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const projects = sortedPosts.filter(({ data }) => data.tags.includes("project"));
const featuredProjects = projects.filter(({ data }) => data.featured);
const experience = sortedPosts.filter(({ data }) => data.tags.includes("experience"));
const skillScale = {
  Beginner: { steps: 1, color: "bg-rose-500" },
  Intermediate: { steps: 2, color: "bg-yellow-400" },
  Advanced: { steps: 3, color: "bg-orange-500" },
  Expert: { steps: 4, color: "bg-green-500" },
};
const skills: { language: string; level: keyof typeof skillScale }[] = [
  { language: "Python", level: "Advanced" },
  { language: "Rust", level: "Intermediate" },
  { language: "C", level: "Advanced" },
  { language: "C++", level: "Advanced" },
  { language: "JavaScript", level: "Intermediate" },
  { language: "TypeScript", level: "Intermediate" },
  { language: "SQL", level: "Intermediate" },
  { language: "Swift", level: "Beginner" },
];
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout title={`${config.site.title} | Portfolio`}>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="bg-muted/30"
  >
    <div class="mx-auto max-w-7xl px-5 pb-12 sm:px-8">
      <section id="hero" class="grid items-center gap-5 border-b border-border py-8 sm:grid-cols-[1fr_auto] sm:gap-12 sm:py-12">
        <div>
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{config.site.title}</h1>
          <p class="mt-3 text-lg text-muted-foreground">Applied AI Software Engineer | Clemson CS '26</p>
          {socials.length > 0 && <div class="mt-4"><Socials /></div>}
        </div>
        <img src="/blankpicture.png" alt="" width="192" height="192"
          class="size-32 rounded-full border border-border object-cover sm:size-48" />
      </section>

      <div class="mt-6 grid items-start gap-6 lg:grid-cols-[minmax(0,1.7fr)_minmax(0,1fr)]">
        <div class="min-w-0 space-y-6">
          <section class="panel">
            <h2>About me</h2>
            <p class="mt-4 leading-relaxed">
              CS senior at Clemson University (graduating Dec 2026) bridging the gap
              between machine learning research and production software. From
              TensorRT-accelerated computer vision on NVIDIA H200 GPUs and sub-250ms
              Vision-Language-Action robotics to full-stack cloud platforms in
              Python, Rust, C++, and TypeScript, I build systems engineered for
              speed, reliability, and scale.
            </p>
          </section>
          <section id="featured" class="panel">
            <h2>{t.home.featured}</h2>
            <ul class="divide-y divide-border">
              {featuredProjects.map(entry => <Card variant="h3" showPreview {...entry} />)}
            </ul>
            <LinkButton href={getRelativeLocaleUrl(locale, "projects")}>
              {t.home.allProjects}
              <IconArrowRight class="inline-block rtl:-rotate-180" />
            </LinkButton>
          </section>
        </div>
        <div class="min-w-0 space-y-6">
          <section id="experience" class="panel">
            <h2>Experience</h2>
            <ul class="divide-y divide-border">
              {experience.map(entry => <Card variant="h3" {...entry} />)}
            </ul>
          </section>
          <section id="skills" class="panel">
            <h2>Programming Skills</h2>
            <dl class="mt-4 divide-y divide-border">
              {skills.map(({ language, level }) => (
                <div class="grid grid-cols-2 items-baseline gap-y-2 py-3">
                  <dt class="font-medium">{language}</dt>
                  <dd class="contents">
                    <span class="text-right text-sm">{level}</span>
                    <span aria-hidden="true" class="col-span-2 grid grid-cols-4 gap-1">
                      {[1, 2, 3, 4].map(step => (
                        <span class:list={["h-2 rounded-sm", step <= skillScale[level].steps ? skillScale[level].color : "bg-muted"]} />
                      ))}
                    </span>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .panel h2 {
    font-size: 1.5rem;
    font-weight: 650;
    letter-spacing: -0.035em;
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
